# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (Leave empty to use built-in in-memory database)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pos_db?retryWrites=true&w=majority

# Stock Reservation Configuration (in seconds, default 300 = 5 minutes)
RESERVATION_DURATION_SEC=300
EXPIRY_WORKER_INTERVAL_MS=5000
