# ===============================================
# POS Order & Inventory System - Environment Config
# ===============================================

# Node Environment ('production' or 'development')
NODE_ENV=production

# Server Port (Railway automatically injects PORT at runtime)
PORT=5000

# PostgreSQL Database Connection String
# On Railway: Injected automatically when adding Railway PostgreSQL!
# Works with:
# - Railway PostgreSQL (+ New -> Database -> Add PostgreSQL)
# - Neon.tech (Free Serverless PostgreSQL)
# - Supabase (Free PostgreSQL)
# If left unset/empty:
# The server automatically falls back to embedded PGlite (PostgreSQL WASM in-memory/file).
DATABASE_URL=postgres://pos_user:pos_password@localhost:5432/pos_system

# JWT Secret for Authentication Bearer Tokens
JWT_SECRET=pos-concurrency-safe-secret-key-987654321

# Concurrency & Order Expiry Settings
RESERVATION_DURATION_SEC=300
EXPIRY_WORKER_INTERVAL_MS=5000

# Client Configuration (Only needed if Frontend is hosted separately from Backend)
# If unified, leave empty or unset:
# VITE_API_URL=https://your-backend.up.railway.app
